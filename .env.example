# ── LLM Provider Selection ───────────────────────────────────────────────────
# Active provider: "groq" | "openrouter" (default: "groq")
LLM_PROVIDER=groq

# Both GROQ_API_KEY and OPENROUTER_API_KEY should be set in environment variables
# so that switching providers via LLM_PROVIDER is a simple config change.
# If LLM_PROVIDER points to a provider whose key is missing, a clear error message is returned.

# Groq — get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — get your free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/free

# Search API — Tavily search key
TAVILY_API_KEY=your_tavily_api_key_here

# Optional — retention cap
MAX_MEMORY_SESSIONS=200
